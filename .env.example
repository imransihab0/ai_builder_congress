# OpenAI (The Agent LLM & Vision Engine)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.1

# Convex project configuration
CONVEX_DEPLOYMENT=dev:...
NEXT_PUBLIC_CONVEX_URL=https://...convex.cloud

# Backend-only Smart Farm dashboard storage
CONVEX_URL=https://...convex.cloud
# Secret deploy key: never expose this variable to frontend code
CONVEX_DEPLOY_KEY=...

# bdapps TAP API (Telecom Charging as a Service & SMS Receipts)
# Leave empty for verified local sandbox simulation with identical S1000 schemas
BDAPPS_APP_ID=
BDAPPS_PASSWORD=
BDAPPS_BASE_URL=https://developer.bdapps.com

# Legacy chat SQLite database (defaults to backend/agrisense.sqlite3)
AGRISENSE_DB_PATH=

# Deployment Port
PORT=8000
